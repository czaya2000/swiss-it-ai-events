---
import Base from '../../../layouts/Base.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SITE_NAME } from '../../../lib/events';

const title = `Check your inbox — ${SITE_NAME}`;
const description = 'Confirm your subscription to the weekly digest.';
---

<Base title={title} description={description} path="/subscribe/thanks/">
	<SiteNav />

	<main class="wrap thanks">
		<h1>Check your inbox.</h1>
		<p>
			We've sent you a confirmation email. Click the link in it and you're on the list. The digest
			goes out on Monday mornings, and every email has a link to change your cities and event types.
		</p>
		<a class="btn accent" href="/">← Back to all events</a>
	</main>

	<SiteFooter />

	<style>
		.thanks {
			padding: 60px 32px;
			text-align: center;
		}
		h1 {
			font-size: clamp(1.5rem, 3vw, 2rem);
			margin: 0 0 8px;
		}
		p {
			color: var(--muted);
			margin: 0 auto 28px;
			max-width: 48ch;
		}
	</style>
</Base>
