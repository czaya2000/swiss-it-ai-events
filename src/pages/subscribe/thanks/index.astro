---
import Base from '../../../layouts/Base.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { SITE_NAME } from '../../../lib/events';

const title = `You're on the list — ${SITE_NAME}`;
const description = 'Thanks for subscribing to the weekly digest.';
---

<Base title={title} description={description} path="/subscribe/thanks/">
	<SiteNav />

	<main class="wrap thanks">
		<h1>You're on the list.</h1>
		<p>
			The digest goes out on Monday mornings. If a week has nothing worth your time, you won't get
			an email — that's the point.
		</p>
		<a class="btn accent" href="/">← Back to all events</a>
	</main>

	<SiteFooter />

	<style>
		.thanks {
			padding: 60px 32px;
			text-align: center;
		}
		h1 {
			font-size: clamp(1.5rem, 3vw, 2rem);
			margin: 0 0 8px;
		}
		p {
			color: var(--muted);
			margin: 0 auto 28px;
			max-width: 48ch;
		}
	</style>
</Base>
