---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import { getCollection } from 'astro:content';
import { dateSpine, formatDateRange, isFree, eventUrl, SITE_URL, SITE_NAME } from '../../lib/events';

export async function getStaticPaths() {
	const entries = await getCollection('events');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const e = entry.data;
const spine = dateSpine(e.date);
const dateLabel = formatDateRange(e.date, e.endDate);
const title = `${e.title} — ${dateLabel}, ${e.city} | ${SITE_NAME}`;
const description = e.blurb;
const isOnline = /online/i.test(e.city);
const free = isFree(e.cost);

const structuredData: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'Event',
		name: e.title,
		startDate: e.date,
		endDate: e.endDate ?? e.date,
		eventAttendanceMode: isOnline
			? 'https://schema.org/OnlineEventAttendanceMode'
			: 'https://schema.org/OfflineEventAttendanceMode',
		eventStatus: 'https://schema.org/EventScheduled',
		location: isOnline
			? { '@type': 'VirtualLocation', url: e.url }
			: {
					'@type': 'Place',
					name: e.venue || e.city,
					address: { '@type': 'PostalAddress', addressLocality: e.city, addressCountry: 'CH' },
				},
		description: e.blurb,
		organizer: { '@type': 'Organization', name: e.organiser },
		url: eventUrl(entry.id),
		...(free ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF', url: e.url } } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL },
			{ '@type': 'ListItem', position: 2, name: e.title, item: eventUrl(entry.id) },
		],
	},
];
---

<Base title={title} description={description} path={`/events/${entry.id}/`} structuredData={structuredData}>
	<SiteNav />
	<main class="wrap detail">
		<a class="back" href="/">← All events</a>

		<div class="detail-head">
			<div class="spine">
				<span class="weekday">{spine.weekday}</span>
				<span class="day">{spine.day}</span>
				<span class="month">{spine.month}</span>
			</div>
			<div>
				<h1>{e.title}</h1>
				<p class="meta mono">
					{dateLabel}{e.time ? ` · ${e.time}` : ''} · {e.city}{e.venue ? ` — ${e.venue}` : ''}
				</p>
				<p class="chips">
					<span class="tag format">{e.format}</span>
					{e.topics.map((t) => <span class="tag topic">{t}</span>)}
					<span class={`tag cost ${free ? 'free' : ''}`}>{e.cost}</span>
				</p>
			</div>
		</div>

		<p class="blurb">{e.blurb}</p>

		<a class="btn accent" href={e.url} target="_blank" rel="noopener noreferrer">
			Register / details on {e.source} ↗
		</a>

		<dl class="facts">
			<dt>Organiser</dt>
			<dd>{e.organiser}</dd>
			<dt>Verified via</dt>
			<dd>{e.source}</dd>
		</dl>

		<p class="disclosure">
			Every listing on {SITE_NAME} is checked against its original source page before publishing.
			Details can change on the organiser's side — always confirm on the link above before you go.
		</p>
	</main>

	<footer class="site-footer wrap">
		<p>{SITE_NAME} — Switzerland only, data/AI/IT-leadership focus for now. <a href="/">Back to all events</a>.</p>
	</footer>

	<style>
		.detail {
			padding: 24px 24px 24px;
		}
		.back {
			color: var(--muted);
			text-decoration: none;
			font-size: 0.88rem;
		}
		.back:hover {
			text-decoration: underline;
		}
		.detail-head {
			display: grid;
			grid-template-columns: 72px 1fr;
			gap: 20px;
			margin: 24px 0 20px;
		}
		.spine {
			border-right: 1px solid var(--border);
			padding-right: 14px;
			display: flex;
			flex-direction: column;
			line-height: 1.15;
		}
		.spine .weekday {
			font-size: 0.7rem;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.06em;
		}
		.spine .day {
			font-size: 1.9rem;
			font-weight: 700;
		}
		.spine .month {
			font-size: 0.78rem;
			color: var(--muted);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}
		h1 {
			font-size: clamp(1.4rem, 3vw, 1.9rem);
			margin: 0 0 8px;
			letter-spacing: -0.01em;
		}
		.meta {
			color: var(--muted);
			font-size: 0.85rem;
			margin: 0 0 12px;
		}
		.chips {
			display: flex;
			gap: 6px;
			flex-wrap: wrap;
			margin: 0;
		}
		.blurb {
			font-size: 1.05rem;
			max-width: 60ch;
			margin: 24px 0;
		}
		.facts {
			display: grid;
			grid-template-columns: max-content 1fr;
			gap: 4px 16px;
			margin: 28px 0;
			font-size: 0.88rem;
		}
		.facts dt {
			color: var(--muted);
		}
		.facts dd {
			margin: 0;
		}
		.disclosure {
			font-size: 0.82rem;
			color: var(--muted);
			max-width: 60ch;
		}
		@media (max-width: 640px) {
			.detail {
				padding: 16px 16px 24px;
			}
			.detail-head {
				grid-template-columns: 1fr;
				gap: 0;
			}
			.spine {
				flex-direction: row;
				align-items: baseline;
				gap: 6px;
				border-right: none;
				border-bottom: 1px solid var(--border);
				padding-right: 0;
				padding-bottom: 8px;
				margin-bottom: 10px;
			}
			.spine .day {
				font-size: 1rem;
				order: -1;
			}
		}
	</style>
</Base>
