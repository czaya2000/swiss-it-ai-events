---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Subscribe from '../../components/Subscribe.astro';
import { getCollection } from 'astro:content';
import {
	formatDateRange,
	isFree,
	eventUrl,
	outboundUrl,
	SITE_URL,
	SITE_NAME,
} from '../../lib/events';

export async function getStaticPaths() {
	const entries = await getCollection('events');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const e = entry.data;
const dateLabel = formatDateRange(e.date, e.endDate);
const title = `${e.title} — ${dateLabel}, ${e.city} | ${SITE_NAME}`;
const description = e.blurb;
const isOnline = /online/i.test(e.city);
const free = isFree(e.cost);
const registerUrl = outboundUrl(e.url);

const structuredData: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'Event',
		name: e.title,
		startDate: e.date,
		endDate: e.endDate ?? e.date,
		eventAttendanceMode: isOnline
			? 'https://schema.org/OnlineEventAttendanceMode'
			: 'https://schema.org/OfflineEventAttendanceMode',
		eventStatus: 'https://schema.org/EventScheduled',
		location: isOnline
			? { '@type': 'VirtualLocation', url: e.url }
			: {
					'@type': 'Place',
					name: e.venue || e.city,
					address: { '@type': 'PostalAddress', addressLocality: e.city, addressCountry: 'CH' },
				},
		description: e.blurb,
		organizer: { '@type': 'Organization', name: e.organiser },
		url: eventUrl(entry.id),
		...(free ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'CHF', url: e.url } } : {}),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: SITE_NAME, item: SITE_URL },
			{ '@type': 'ListItem', position: 2, name: e.title, item: eventUrl(entry.id) },
		],
	},
];
---

<Base
	title={title}
	description={description}
	path={`/events/${entry.id}/`}
	structuredData={structuredData}
>
	<SiteNav />
	<main class="wrap detail">
		<a class="back" href="/">← All events</a>

		<div class="detail-grid">
			<div class="detail-main">
				<p class="dateline num">{dateLabel}{e.time ? `, ${e.time}` : ''}</p>
				<h1>{e.title}</h1>
				<p class="blurb">{e.blurb}</p>

				<dl class="facts">
					<dt>Dates</dt>
					<dd class="num">{dateLabel}</dd>

					{
						e.time && (
							<>
								<dt>Time</dt>
								<dd class="num">{e.time}</dd>
							</>
						)
					}

					<dt>City</dt>
					<dd>{e.city}</dd>

					{
						e.venue && (
							<>
								<dt>Venue</dt>
								<dd>{e.venue}</dd>
							</>
						)
					}

					<dt>Organiser</dt>
					<dd>{e.organiser}</dd>

					<dt>Format</dt>
					<dd>{e.format}</dd>

					<dt>Cost</dt>
					<dd class={free ? 'free' : ''}>{e.cost}</dd>

					<dt>Topics</dt>
					<dd>{e.topics.join(', ')}</dd>

					<dt>Verified via</dt>
					<dd>{e.source}</dd>
				</dl>
			</div>

			<aside class="register">
				<div class="register-card">
					<p class="register-title">Register with the organiser</p>
					<p class="register-note">
						Registration is handled on {e.source}. We do not sell tickets or take a commission.
					</p>
					<a
						class="btn accent register-btn"
						href={registerUrl}
						target="_blank"
						rel="noopener"
						data-outbound={e.source}
					>
						Go to {e.source} ↗
					</a>
				</div>
				<p class="disclosure">
					Every listing on {SITE_NAME} is checked against its original source page before
					publishing. Details can change on the organiser's side — always confirm on the link
					above before you go.
				</p>
				<Subscribe placement="event" compact />
			</aside>
		</div>
	</main>

	<SiteFooter>
		{SITE_NAME} — Switzerland only, data/AI/IT-leadership focus for now. <a href="/"
			>Back to all events</a
		>.
	</SiteFooter>

	<style>
		.detail {
			padding-top: 28px;
		}
		.back {
			color: var(--muted);
			text-decoration: none;
			font-size: 0.875rem;
		}
		.back:hover {
			color: var(--ink);
		}
		.detail-grid {
			display: grid;
			grid-template-columns: 1fr 340px;
			gap: 72px;
			align-items: start;
			margin-top: 36px;
		}
		.dateline {
			color: var(--muted);
			font-size: 0.875rem;
			margin: 0 0 14px;
		}
		h1 {
			font-size: clamp(1.9rem, 4vw, 2.8rem);
			font-weight: 600;
			line-height: 1.08;
			letter-spacing: -0.03em;
			margin: 0;
			max-width: 20ch;
			text-wrap: pretty;
		}
		.blurb {
			font-size: 1.1rem;
			line-height: 1.55;
			color: var(--ink-2);
			max-width: 60ch;
			margin: 24px 0 0;
		}
		.facts {
			display: grid;
			grid-template-columns: 150px 1fr;
			gap: 0 40px;
			margin: 40px 0 0;
			font-size: 0.95rem;
			border-top: 1px solid var(--border);
		}
		.facts dt {
			color: var(--muted);
			padding: 15px 0;
			border-bottom: 1px solid var(--border);
		}
		.facts dd {
			margin: 0;
			padding: 15px 0;
			border-bottom: 1px solid var(--border);
		}
		.facts dd.free {
			font-weight: 600;
		}
		.register {
			padding-top: 44px;
		}
		.register-card {
			border: 1px solid var(--ink);
			padding: 26px;
		}
		.register-title {
			font-size: 0.95rem;
			font-weight: 600;
			margin: 0;
		}
		.register-note {
			font-size: 0.82rem;
			color: var(--muted);
			line-height: 1.55;
			margin: 8px 0 0;
		}
		.register-btn {
			width: 100%;
			margin-top: 20px;
			padding: 13px 16px;
		}
		.disclosure {
			font-size: 0.82rem;
			color: var(--muted);
			line-height: 1.65;
			margin: 22px 0 28px;
		}

		@media (max-width: 900px) {
			.detail-grid {
				grid-template-columns: 1fr;
				gap: 36px;
			}
			.register {
				padding-top: 0;
			}
			h1 {
				max-width: none;
			}
		}
		@media (max-width: 640px) {
			.detail {
				padding-top: 20px;
			}
			.detail-grid {
				margin-top: 24px;
			}
			.facts {
				grid-template-columns: 110px 1fr;
				gap: 0 20px;
			}
		}
	</style>
</Base>
