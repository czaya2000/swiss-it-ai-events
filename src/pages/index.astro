---
import Base from '../layouts/Base.astro';
import Listing from '../components/Listing.astro';
import {
	getUpcomingEvents,
	eventUrl,
	SITE_URL,
	SITE_NAME,
	SITE_TAGLINE,
	SITE_HEADLINE,
	SITE_SUBHEADLINE,
	INSTAGRAM_URL,
} from '../lib/events';

// The listing itself (filters, rows, script, styles) is src/components/Listing.astro,
// shared with the city and type pages in src/pages/[hub]/index.astro.
const entries = await getUpcomingEvents();

const title = `${SITE_NAME} — AI & data events across Switzerland`;
const description = SITE_TAGLINE;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_NAME,
		url: SITE_URL,
		description: SITE_TAGLINE,
		inLanguage: 'en',
		publisher: { '@id': `${SITE_URL}/#organization` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': `${SITE_URL}/#organization`,
		name: SITE_NAME,
		url: SITE_URL,
		logo: `${SITE_URL}/apple-touch-icon.png`,
		description: SITE_TAGLINE,
		areaServed: { '@type': 'Country', name: 'Switzerland' },
		sameAs: [INSTAGRAM_URL],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		itemListElement: entries.map((e, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: eventUrl(e.id),
			name: e.data.title,
		})),
	},
];
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
	<Listing entries={entries} headline={SITE_HEADLINE} subheadline={SITE_SUBHEADLINE} />
</Base>
