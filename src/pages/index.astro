---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import {
	getUpcomingEvents,
	isNew,
	dateSpine,
	isFree,
	eventUrl,
	formatLastScan,
	weekStart,
	weekBand,
	SITE_URL,
	SITE_NAME,
	SITE_TAGLINE,
	SITE_HEADLINE,
} from '../lib/events';
import meta from '../data/meta.json';

const lastScan = formatLastScan(meta.lastScan);
const entries = await getUpcomingEvents();
const events = entries.map((e) => ({ id: e.id, ...e.data }));

const cities = [...new Set(events.map((e) => e.city))].sort();
const formats = [...new Set(events.map((e) => e.format))].sort();

// Events arrive sorted by date, so grouping is a single pass. Each group is
// the week the event STARTS in; a multi-day event sits in its start week.
type Row = (typeof events)[number];
const groups: { band: ReturnType<typeof weekBand>; rows: Row[] }[] = [];
for (const e of events) {
	const key = weekStart(e.date);
	const last = groups[groups.length - 1];
	if (last && last.band.key === key) last.rows.push(e);
	else groups.push({ band: weekBand(key), rows: [e] });
}

const title = `${SITE_NAME} — Switzerland's IT & AI events, curated`;
const description = SITE_TAGLINE;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_NAME,
		url: SITE_URL,
		description: SITE_TAGLINE,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		itemListElement: events.map((e, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: eventUrl(e.id),
			name: e.title,
		})),
	},
];
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
	<SiteNav>
		<button id="density-toggle" class="btn ghost" type="button" data-density="comfortable">
			Compact
		</button>
	</SiteNav>

	<header class="statement wrap">
		<h1>{SITE_HEADLINE}</h1>
	</header>

	<main class="wrap">
		<div class="controls">
			<div class="filters">
				<label class="search-label">
					<span class="sr-only">Search</span>
					<input type="search" id="filter-search" placeholder="Search title, organiser, topic…" />
				</label>
				<label>
					<span class="sr-only">City</span>
					<select id="filter-city">
						<option value="">All cities</option>
						{cities.map((c) => <option value={c}>{c}</option>)}
					</select>
				</label>
				<label>
					<span class="sr-only">Format</span>
					<select id="filter-format">
						<option value="">All formats</option>
						{formats.map((f) => <option value={f}>{f}</option>)}
					</select>
				</label>
				<label class="checkbox-label">
					<input type="checkbox" id="filter-new" />
					New only
				</label>
			</div>

			<div class="when-row">
				<div class="when-tabs" role="tablist" aria-label="Time range">
					<button class="when-tab" data-when="all" type="button">All</button>
					<button class="when-tab" data-when="today" type="button">Today</button>
					<button class="when-tab" data-when="week" type="button">This week</button>
					<button class="when-tab" data-when="month" type="button">This month</button>
					<button class="when-tab" data-when="weekend" type="button">Weekend</button>
				</div>
				<span id="result-count" class="result-count num"></span>
			</div>
		</div>

		<ul class="events" id="event-list">
			{
				groups.map((g) => (
					<>
						<li class={`band ${g.band.current ? 'current' : ''}`} data-band={g.band.key}>
							<div class="band-label">
								<span class="band-primary num">{g.band.primary}</span>
								{g.band.secondary && <span class="band-secondary num">{g.band.secondary}</span>}
							</div>
						</li>
						{g.rows.map((e) => {
							const spine = dateSpine(e.date);
							const isMultiDay = !!e.endDate && e.endDate !== e.date;
							const endSpine = isMultiDay ? dateSpine(e.endDate) : null;
							const eNew = isNew(e.firstSeen);
							const free = isFree(e.cost);
							// Built as one string: separate JSX expressions would each be
							// wrapped in whitespace, producing "Zurich , ETH UNO building".
							const metaLine = [e.city, e.venue, e.time].filter(Boolean).join(', ');
							return (
								<li
									class="row"
									data-band={g.band.key}
									data-city={e.city}
									data-format={e.format}
									data-new={eNew}
									data-date={e.date}
									data-end-date={e.endDate ?? e.date}
									data-search={[e.title, e.organiser, e.city, e.venue, ...e.topics]
										.join(' ')
										.toLowerCase()}
								>
									<a class="row-link" href={`/events/${e.id}/`}>
										<div class="spine">
											<span class="day num">{spine.day}</span>
											<span class="dm">
												{spine.weekday}, {spine.month}
											</span>
											{isMultiDay && endSpine && (
												<span class="through num">
													to {endSpine.day} {endSpine.month}
												</span>
											)}
										</div>
										<div class="content">
											<h2 class="title">
												{eNew && <span class="new-dot" aria-hidden="true" />}
												{e.title}
												{eNew && <span class="sr-only">(new)</span>}
											</h2>
											<p class="meta">{metaLine}</p>
											<p class="blurb">{e.blurb}</p>
										</div>
										<div class="aside">
											<span class="format">{e.format}</span>
											<span class={`cost ${free ? 'free' : ''}`}>{e.cost}</span>
										</div>
									</a>
								</li>
							);
						})}
					</>
				))
			}
		</ul>

		<p id="empty-state" class="empty-state" hidden>No events match those filters.</p>
	</main>

	<footer class="site-footer wrap">
		<p>
			Switzerland only, data/AI/IT-leadership focus for now. Every event is verified against its
			original page before listing. Refreshed automatically each morning — last scanned {lastScan}.
		</p>
	</footer>

	<script is:inline>
		(function () {
			var searchInput = document.getElementById('filter-search');
			var citySelect = document.getElementById('filter-city');
			var formatSelect = document.getElementById('filter-format');
			var newCheckbox = document.getElementById('filter-new');
			var whenTabs = Array.prototype.slice.call(document.querySelectorAll('.when-tab'));
			var densityBtn = document.getElementById('density-toggle');
			var rows = Array.prototype.slice.call(document.querySelectorAll('.row'));
			var bands = Array.prototype.slice.call(document.querySelectorAll('.band'));
			var resultCount = document.getElementById('result-count');
			var emptyState = document.getElementById('empty-state');

			var params = new URLSearchParams(location.search);
			var state = {
				q: params.get('q') || '',
				city: params.get('city') || '',
				format: params.get('format') || '',
				when: params.get('when') || 'all',
				isNew: params.get('new') === '1',
			};

			searchInput.value = state.q;
			citySelect.value = state.city;
			formatSelect.value = state.format;
			newCheckbox.checked = state.isNew;

			function pad(n) {
				return String(n).padStart(2, '0');
			}
			function toISO(d) {
				return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
			}

			function whenBounds(when) {
				var now = new Date();
				now.setHours(0, 0, 0, 0);
				var todayStr = toISO(now);
				if (when === 'today') return { start: todayStr, end: todayStr };
				if (when === 'week') {
					var weekEnd = new Date(now);
					weekEnd.setDate(weekEnd.getDate() + 6);
					return { start: todayStr, end: toISO(weekEnd) };
				}
				if (when === 'month') {
					var monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
					return { start: todayStr, end: toISO(monthEnd) };
				}
				if (when === 'weekend') {
					var day = now.getDay();
					var toSat = (6 - day + 7) % 7;
					var sat = new Date(now);
					sat.setDate(sat.getDate() + toSat);
					var sun = new Date(sat);
					sun.setDate(sun.getDate() + 1);
					return { start: toISO(sat), end: toISO(sun) };
				}
				return null;
			}

			function updateUrl() {
				var p = new URLSearchParams();
				if (state.q) p.set('q', state.q);
				if (state.city) p.set('city', state.city);
				if (state.format) p.set('format', state.format);
				if (state.when && state.when !== 'all') p.set('when', state.when);
				if (state.isNew) p.set('new', '1');
				var qs = p.toString();
				history.replaceState(null, '', qs ? '?' + qs : location.pathname);
			}

			function applyFilters() {
				var query = state.q.trim().toLowerCase();
				var bounds = whenBounds(state.when);
				var visible = 0;
				var perBand = {};
				for (var i = 0; i < rows.length; i++) {
					var row = rows[i];
					var d = row.dataset;
					var matches =
						(!query || (d.search || '').indexOf(query) !== -1) &&
						(!state.city || d.city === state.city) &&
						(!state.format || d.format === state.format) &&
						(!state.isNew || d.new === 'true') &&
						(!bounds || (d.date <= bounds.end && d.endDate >= bounds.start));
					row.hidden = !matches;
					if (matches) {
						visible++;
						perBand[d.band] = true;
					}
				}
				// A week heading with every row filtered out is a heading for
				// nothing — hide it with its rows.
				for (var b = 0; b < bands.length; b++) {
					bands[b].hidden = !perBand[bands[b].dataset.band];
				}
				resultCount.textContent = visible + ' event' + (visible === 1 ? '' : 's');
				emptyState.hidden = visible !== 0;
			}

			function setWhenTab(when) {
				state.when = when;
				whenTabs.forEach(function (btn) {
					var active = btn.dataset.when === when;
					btn.classList.toggle('active', active);
					btn.setAttribute('aria-selected', String(active));
				});
			}

			searchInput.addEventListener('input', function () {
				state.q = searchInput.value;
				updateUrl();
				applyFilters();
			});
			citySelect.addEventListener('change', function () {
				state.city = citySelect.value;
				updateUrl();
				applyFilters();
			});
			formatSelect.addEventListener('change', function () {
				state.format = formatSelect.value;
				updateUrl();
				applyFilters();
			});
			newCheckbox.addEventListener('change', function () {
				state.isNew = newCheckbox.checked;
				updateUrl();
				applyFilters();
			});
			whenTabs.forEach(function (btn) {
				btn.addEventListener('click', function () {
					setWhenTab(btn.dataset.when);
					updateUrl();
					applyFilters();
				});
			});

			setWhenTab(state.when);
			applyFilters();

			// Density toggle (compact / comfortable), persisted locally — a display
			// preference, not shareable filter state, so it stays out of the URL.
			var eventList = document.getElementById('event-list');
			function setDensity(density) {
				eventList.classList.toggle('compact', density === 'compact');
				densityBtn.textContent = density === 'compact' ? 'Comfortable' : 'Compact';
				densityBtn.dataset.density = density;
			}
			var savedDensity = 'comfortable';
			try {
				savedDensity = localStorage.getItem('density') || 'comfortable';
			} catch (e) {}
			setDensity(savedDensity);
			densityBtn.addEventListener('click', function () {
				var next = densityBtn.dataset.density === 'compact' ? 'comfortable' : 'compact';
				setDensity(next);
				try {
					localStorage.setItem('density', next);
				} catch (e) {}
			});
		})();
	</script>

	<style>
		.statement {
			padding-top: 56px;
		}
		.statement h1 {
			font-size: clamp(1.6rem, 3.2vw, 2.15rem);
			font-weight: 500;
			line-height: 1.18;
			letter-spacing: -0.02em;
			margin: 0;
			max-width: 32ch;
			text-wrap: pretty;
		}

		main {
			padding-bottom: 8px;
		}
		.controls {
			display: flex;
			flex-direction: column;
			gap: 16px;
			padding-top: 44px;
			padding-bottom: 14px;
			border-bottom: 1px solid var(--border);
		}
		.when-row {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			gap: 32px;
		}
		.when-tabs {
			display: flex;
			gap: 22px;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}
		.when-tabs::-webkit-scrollbar {
			display: none;
		}
		.when-tab {
			flex: none;
			white-space: nowrap;
			font: inherit;
			font-size: 0.875rem;
			background: none;
			border: none;
			border-bottom: 2px solid transparent;
			padding: 0 0 5px;
			color: var(--muted);
			cursor: pointer;
			margin-bottom: -1px;
		}
		.when-tab.active {
			color: var(--ink);
			font-weight: 600;
			border-bottom-color: var(--ink);
		}
		.filters {
			display: flex;
			gap: 18px;
			align-items: flex-end;
			flex-wrap: wrap;
		}
		select,
		input[type='search'] {
			font: inherit;
			font-size: 0.875rem;
			padding: 0 0 5px;
			border: none;
			border-bottom: 1px solid var(--border);
			border-radius: 0;
			background: transparent;
			color: var(--ink);
		}
		select:focus,
		input[type='search']:focus {
			outline: none;
			border-bottom-color: var(--ink);
		}
		.search-label input {
			width: 190px;
		}
		.checkbox-label {
			display: flex;
			align-items: center;
			gap: 6px;
			font-size: 0.875rem;
			color: var(--muted);
			padding-bottom: 5px;
		}
		.result-count {
			color: var(--muted);
			font-size: 0.875rem;
			padding-bottom: 5px;
		}

		.events {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		/* Week band. The date range is the label; week numbers are never shown. */
		.band {
			display: grid;
			padding: 38px 0 12px;
		}
		.band[hidden] {
			display: none;
		}
		.band-label {
			display: flex;
			gap: 14px;
			align-items: baseline;
			white-space: nowrap;
		}
		.band-primary {
			font-size: 0.95rem;
			font-weight: 600;
		}
		.band-secondary {
			font-size: 0.82rem;
			color: var(--muted);
		}
		/* The accent's second and last appearance: the week we are in. */
		.band.current .band-primary,
		.band.current .band-secondary {
			color: var(--accent);
		}

		.row {
			border-bottom: 1px solid var(--border);
		}
		.row-link {
			display: grid;
			grid-template-columns: 92px 1fr 176px;
			gap: 36px;
			padding: 18px 0;
			text-decoration: none;
			color: inherit;
		}
		.spine {
			display: flex;
			flex-direction: column;
		}
		.spine .day {
			font-size: 1.85rem;
			font-weight: 600;
			line-height: 1;
		}
		.spine .dm {
			font-size: 0.75rem;
			color: var(--muted);
			margin-top: 5px;
		}
		.spine .through {
			font-size: 0.75rem;
			color: var(--muted);
			white-space: nowrap;
		}
		.title {
			margin: 0;
			font-size: 1.18rem;
			font-weight: 500;
			letter-spacing: -0.01em;
			line-height: 1.28;
			display: flex;
			align-items: baseline;
			gap: 8px;
			text-wrap: pretty;
		}
		.row-link:hover .title {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		.meta {
			margin: 6px 0 0;
			color: var(--ink-2);
			font-size: 0.875rem;
		}
		.blurb {
			margin: 3px 0 0;
			font-size: 0.82rem;
			color: var(--muted);
			max-width: 72ch;
		}
		.events.compact .blurb {
			display: none;
		}
		.aside {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			text-align: right;
			gap: 4px;
		}
		.aside .format {
			font-size: 0.875rem;
		}
		.aside .cost {
			font-size: 0.82rem;
			color: var(--muted);
		}
		.aside .cost.free {
			color: var(--ink);
			font-weight: 600;
		}
		.empty-state {
			color: var(--muted);
			padding: 48px 0;
		}

		@media (max-width: 640px) {
			.statement {
				padding-top: 32px;
			}
			.statement h1 {
				max-width: none;
			}
			.controls {
				padding-top: 28px;
			}
			.search-label input {
				width: 150px;
			}
			.band {
				gap: 8px;
				padding: 28px 0 10px;
			}
			.row-link {
				grid-template-columns: 1fr;
				gap: 8px;
				padding: 16px 0;
			}
			.spine {
				flex-direction: row;
				align-items: baseline;
				gap: 8px;
			}
			.spine .day {
				font-size: 1.3rem;
			}
			.spine .dm,
			.spine .through {
				margin-top: 0;
			}
			.title {
				font-size: 1.05rem;
			}
			.aside {
				flex-direction: row;
				align-items: baseline;
				justify-content: flex-start;
				text-align: left;
				gap: 14px;
			}
		}
	</style>
</Base>
