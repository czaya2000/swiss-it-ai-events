---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Subscribe from '../components/Subscribe.astro';
import {
	getUpcomingEvents,
	isNew,
	dateSpine,
	isFree,
	eventUrl,
	formatLastScan,
	weekStart,
	weekBand,
	SITE_URL,
	SITE_NAME,
	SITE_TAGLINE,
	SITE_HEADLINE,
} from '../lib/events';
import meta from '../data/meta.json';

const lastScan = formatLastScan(meta.lastScan);
const entries = await getUpcomingEvents();
const events = entries.map((e) => ({ id: e.id, ...e.data }));

const cities = [...new Set(events.map((e) => e.city))].sort();
const formats = [...new Set(events.map((e) => e.format))].sort();

// Events arrive sorted by date, so grouping is a single pass. Each group is
// the week the event STARTS in; a multi-day event sits in its start week.
type Row = (typeof events)[number];
const groups: { band: ReturnType<typeof weekBand>; rows: Row[] }[] = [];
for (const e of events) {
	const key = weekStart(e.date);
	const last = groups[groups.length - 1];
	if (last && last.band.key === key) last.rows.push(e);
	else groups.push({ band: weekBand(key), rows: [e] });
}

const title = `${SITE_NAME} — Switzerland's IT & AI events, curated`;
const description = SITE_TAGLINE;

const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_NAME,
		url: SITE_URL,
		description: SITE_TAGLINE,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		itemListElement: events.map((e, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: eventUrl(e.id),
			name: e.title,
		})),
	},
];
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
	<SiteNav>
		<div class="search-wrap">
			<button type="button" id="search-toggle" class="search-toggle" aria-expanded="false">
				<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
					<path
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						d="M15.5 15.5 21 21M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"
					></path>
				</svg>
				<span class="sr-only">Search</span>
			</button>
			<label class="search-label">
				<span class="sr-only">Search</span>
				<input type="search" id="filter-search" placeholder="Search title, organiser, topic…" />
			</label>
		</div>
	</SiteNav>

	<header class="statement wrap">
		<h1>{SITE_HEADLINE}</h1>
	</header>

	{
		// Subscribe block hidden for now — flip this back on when ready.
		false && (
			<div class="wrap subscribe-slot">
				<Subscribe placement="home" />
			</div>
		)
	}

	<main class="wrap">
		<div class="controls">
			<div class="filter-row">
				<div class="when-tabs" role="tablist" aria-label="Time range">
					<button class="when-tab" data-when="all" type="button">All</button>
					<button class="when-tab" data-when="week" type="button">This week</button>
					<button class="when-tab" data-when="month" type="button">This month</button>
				</div>
				<label>
					<span class="sr-only">City</span>
					<select id="filter-city">
						<option value="">City</option>
						{cities.map((c) => <option value={c}>{c}</option>)}
					</select>
				</label>
				<label>
					<span class="sr-only">Format</span>
					<select id="filter-format">
						<option value="">Format</option>
						{formats.map((f) => <option value={f}>{f}</option>)}
					</select>
				</label>
			</div>
		</div>

		<ul class="events" id="event-list">
			{
				groups.map((g) => (
					<>
						<li class={`band ${g.band.current ? 'current' : ''}`} data-band={g.band.key}>
							<div class="band-label">
								<span class="band-primary num">{g.band.primary}</span>
							</div>
						</li>
						{g.rows.map((e) => {
							const spine = dateSpine(e.date);
							const isMultiDay = !!e.endDate && e.endDate !== e.date;
							const endSpine = isMultiDay ? dateSpine(e.endDate) : null;
							const eNew = isNew(e.firstSeen);
							const free = isFree(e.cost);
							// Built as one string: separate JSX expressions would each be
							// wrapped in whitespace, producing "Zurich , ETH UNO building".
							const metaLine = [e.city, e.venue, e.time].filter(Boolean).join(', ');
							return (
								<li
									class="row"
									data-band={g.band.key}
									data-city={e.city}
									data-format={e.format}
									data-date={e.date}
									data-end-date={e.endDate ?? e.date}
									data-search={[e.title, e.organiser, e.city, e.venue, ...e.topics]
										.join(' ')
										.toLowerCase()}
								>
									<a class="row-link" href={`/events/${e.id}/`}>
										<div class="spine">
											<span class="day num">{spine.day}</span>
											<span class="dm">
												{spine.weekday}, {spine.month}
											</span>
											{isMultiDay && endSpine && (
												<span class="through num">
													to {endSpine.day} {endSpine.month}
												</span>
											)}
										</div>
										<div class="content">
											<h2 class="title">
												{eNew && <span class="new-dot" aria-hidden="true" />}
												{e.title}
												{eNew && <span class="sr-only">(new)</span>}
											</h2>
											<p class="meta">{metaLine}</p>
											<p class="blurb">{e.blurb}</p>
										</div>
										<div class="aside">
											<span class="format">{e.format}</span>
											<span class={`cost ${free ? 'free' : ''}`}>{e.cost}</span>
										</div>
									</a>
								</li>
							);
						})}
					</>
				))
			}
		</ul>

		<p id="empty-state" class="empty-state" hidden>No events match those filters.</p>
	</main>

	<SiteFooter><span id="result-count" class="num"></span> shown. Last scanned {lastScan}.</SiteFooter>

	<script is:inline>
		(function () {
			var searchInput = document.getElementById('filter-search');
			var searchWrap = document.querySelector('.search-wrap');
			var searchToggle = document.getElementById('search-toggle');
			var citySelect = document.getElementById('filter-city');
			var formatSelect = document.getElementById('filter-format');
			var whenTabs = Array.prototype.slice.call(document.querySelectorAll('.when-tab'));
			var rows = Array.prototype.slice.call(document.querySelectorAll('.row'));
			var bands = Array.prototype.slice.call(document.querySelectorAll('.band'));
			var resultCount = document.getElementById('result-count');
			var emptyState = document.getElementById('empty-state');

			var params = new URLSearchParams(location.search);
			var state = {
				q: params.get('q') || '',
				city: params.get('city') || '',
				format: params.get('format') || '',
				when: params.get('when') || 'all',
			};

			searchInput.value = state.q;
			citySelect.value = state.city;
			formatSelect.value = state.format;

			function setSearchOpen(open, focus) {
				searchWrap.classList.toggle('open', open);
				searchToggle.setAttribute('aria-expanded', String(open));
				searchInput.tabIndex = open ? 0 : -1;
				if (open && focus) searchInput.focus();
			}
			setSearchOpen(!!state.q, false);

			function pad(n) {
				return String(n).padStart(2, '0');
			}
			function toISO(d) {
				return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
			}

			function whenBounds(when) {
				var now = new Date();
				now.setHours(0, 0, 0, 0);
				var todayStr = toISO(now);
				if (when === 'week') {
					var weekEnd = new Date(now);
					weekEnd.setDate(weekEnd.getDate() + 6);
					return { start: todayStr, end: toISO(weekEnd) };
				}
				if (when === 'month') {
					var monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0);
					return { start: todayStr, end: toISO(monthEnd) };
				}
				return null;
			}

			function updateUrl() {
				var p = new URLSearchParams();
				if (state.q) p.set('q', state.q);
				if (state.city) p.set('city', state.city);
				if (state.format) p.set('format', state.format);
				if (state.when && state.when !== 'all') p.set('when', state.when);
				var qs = p.toString();
				history.replaceState(null, '', qs ? '?' + qs : location.pathname);
			}

			function applyFilters() {
				var query = state.q.trim().toLowerCase();
				var bounds = whenBounds(state.when);
				var visible = 0;
				var perBand = {};
				for (var i = 0; i < rows.length; i++) {
					var row = rows[i];
					var d = row.dataset;
					var matches =
						(!query || (d.search || '').indexOf(query) !== -1) &&
						(!state.city || d.city === state.city) &&
						(!state.format || d.format === state.format) &&
						(!bounds || (d.date <= bounds.end && d.endDate >= bounds.start));
					row.hidden = !matches;
					if (matches) {
						visible++;
						perBand[d.band] = true;
					}
				}
				// A week heading with every row filtered out is a heading for
				// nothing — hide it with its rows.
				for (var b = 0; b < bands.length; b++) {
					bands[b].hidden = !perBand[bands[b].dataset.band];
				}
				resultCount.textContent = visible + ' event' + (visible === 1 ? '' : 's');
				emptyState.hidden = visible !== 0;
			}

			function setWhenTab(when) {
				state.when = when;
				whenTabs.forEach(function (btn) {
					var active = btn.dataset.when === when;
					btn.classList.toggle('active', active);
					btn.setAttribute('aria-selected', String(active));
				});
			}

			searchToggle.addEventListener('click', function () {
				setSearchOpen(!searchWrap.classList.contains('open'), true);
			});
			searchInput.addEventListener('input', function () {
				state.q = searchInput.value;
				updateUrl();
				applyFilters();
			});
			searchInput.addEventListener('blur', function () {
				if (!searchInput.value) setSearchOpen(false, false);
			});
			citySelect.addEventListener('change', function () {
				state.city = citySelect.value;
				updateUrl();
				applyFilters();
			});
			formatSelect.addEventListener('change', function () {
				state.format = formatSelect.value;
				updateUrl();
				applyFilters();
			});
			whenTabs.forEach(function (btn) {
				btn.addEventListener('click', function () {
					setWhenTab(btn.dataset.when);
					updateUrl();
					applyFilters();
				});
			});

			setWhenTab(state.when);
			applyFilters();
		})();
	</script>

	<style>
		.statement {
			padding-top: 56px;
		}
		.statement h1 {
			font-size: clamp(1.6rem, 3.2vw, 2.15rem);
			font-weight: 500;
			line-height: 1.18;
			letter-spacing: -0.02em;
			margin: 0;
			max-width: 32ch;
			text-wrap: pretty;
		}

		main {
			padding-bottom: 8px;
		}
		.subscribe-slot {
			margin-top: 36px;
		}
		.controls {
			display: flex;
			flex-direction: column;
			gap: 16px;
			padding-top: 32px;
			padding-bottom: 14px;
			border-bottom: 1px solid var(--border);
		}
		.when-tabs {
			display: flex;
			gap: 22px;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}
		.when-tabs::-webkit-scrollbar {
			display: none;
		}
		.when-tab {
			flex: none;
			white-space: nowrap;
			font: inherit;
			font-size: 0.875rem;
			background: none;
			border: none;
			border-bottom: 2px solid transparent;
			padding: 0 0 5px;
			color: var(--muted);
			cursor: pointer;
			margin-bottom: -1px;
		}
		.when-tab.active {
			color: var(--ink);
			font-weight: 600;
			border-bottom-color: var(--ink);
		}
		.filter-row {
			display: flex;
			gap: 18px;
			align-items: flex-end;
			flex-wrap: wrap;
		}
		select,
		input[type='search'] {
			font: inherit;
			font-size: 0.875rem;
			padding: 0 0 5px;
			border: none;
			border-bottom: 1px solid var(--border);
			border-radius: 0;
			background: transparent;
			color: var(--ink);
		}
		select:focus,
		input[type='search']:focus {
			outline: none;
			border-bottom-color: var(--ink);
		}
		.search-wrap {
			display: flex;
			align-items: center;
		}
		.search-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 32px;
			height: 32px;
			padding: 0;
			background: none;
			border: none;
			color: var(--muted);
			cursor: pointer;
			flex: none;
		}
		.search-toggle:hover,
		.search-wrap.open .search-toggle {
			color: var(--accent);
		}
		.search-label {
			width: 0;
			overflow: hidden;
			transition: width 0.18s ease;
		}
		.search-wrap.open .search-label {
			width: 200px;
		}
		.search-label input {
			width: 100%;
			height: 32px;
			padding: 0 0 0 2px;
			border: none;
			border-bottom: 1px solid var(--border);
		}
		.search-label input:focus {
			border-bottom-color: var(--ink);
		}
		.events {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		/* Week band. The date range is the label; week numbers are never shown. */
		.band {
			display: grid;
			padding: 38px 0 12px;
		}
		.band[hidden] {
			display: none;
		}
		.band-label {
			display: flex;
			gap: 14px;
			align-items: baseline;
			white-space: nowrap;
		}
		.band-primary {
			font-size: 0.95rem;
			font-weight: 600;
		}
		/* The accent's second and last appearance: the week we are in. */
		.band.current .band-primary {
			color: var(--accent);
		}

		.row {
			border-bottom: 1px solid var(--border);
		}
		.row-link {
			display: grid;
			grid-template-columns: 92px 1fr 176px;
			gap: 36px;
			padding: 18px 0;
			text-decoration: none;
			color: inherit;
		}
		.spine {
			display: flex;
			flex-direction: column;
		}
		.spine .day {
			font-size: 1.85rem;
			font-weight: 600;
			line-height: 1;
		}
		.spine .dm {
			font-size: 0.75rem;
			color: var(--muted);
			margin-top: 5px;
		}
		.spine .through {
			font-size: 0.75rem;
			color: var(--muted);
			white-space: nowrap;
		}
		.title {
			margin: 0;
			font-size: 1.18rem;
			font-weight: 500;
			letter-spacing: -0.01em;
			line-height: 1.28;
			display: flex;
			align-items: baseline;
			gap: 8px;
			text-wrap: pretty;
		}
		.row-link:hover .title {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		.meta {
			margin: 6px 0 0;
			color: var(--ink-2);
			font-size: 0.875rem;
		}
		.blurb {
			margin: 3px 0 0;
			font-size: 0.82rem;
			color: var(--muted);
			max-width: 72ch;
		}
		.aside {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			text-align: right;
			gap: 4px;
		}
		.aside .format {
			font-size: 0.875rem;
		}
		.aside .cost {
			font-size: 0.82rem;
			color: var(--muted);
		}
		.aside .cost.free {
			color: var(--ink);
			font-weight: 600;
		}
		.empty-state {
			color: var(--muted);
			padding: 48px 0;
		}

		@media (max-width: 640px) {
			.statement {
				padding-top: 32px;
			}
			.statement h1 {
				max-width: none;
			}
			.subscribe-slot {
				margin-top: 24px;
			}
			.controls {
				padding-top: 24px;
			}
			.band {
				gap: 8px;
				padding: 28px 0 10px;
			}
			.row-link {
				grid-template-columns: 1fr;
				gap: 8px;
				padding: 16px 0;
			}
			.spine {
				flex-direction: row;
				align-items: baseline;
				gap: 8px;
			}
			.spine .day {
				font-size: 1.3rem;
			}
			.spine .dm,
			.spine .through {
				margin-top: 0;
			}
			.title {
				font-size: 1.05rem;
			}
			.aside {
				flex-direction: row;
				align-items: baseline;
				justify-content: flex-start;
				text-align: left;
				gap: 14px;
			}
		}
	</style>
</Base>
