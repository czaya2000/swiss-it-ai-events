---
import '../styles/theme.css';
import { SITE_NAME, SITE_URL, GOOGLE_SITE_VERIFICATION } from '../lib/events';

interface Props {
	title: string;
	description: string;
	path: string;
	structuredData?: Record<string, unknown>[];
	/** Keep the page reachable but out of search results (e.g. ended events). */
	noindex?: boolean;
}

const { title, description, path, structuredData = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE_URL).toString();
const ogImage = new URL('/og-image.png', SITE_URL).toString();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&display=swap"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Machine-readable versions of the event list, for feed readers and AI agents -->
		<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — upcoming events`} href="/rss.xml" />
		<link rel="alternate" type="application/json" title={`${SITE_NAME} — events (JSON)`} href="/events.json" />
		<link rel="alternate" type="text/markdown" title={`${SITE_NAME} — llms.txt`} href="/llms.txt" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_CH" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1469" />
		<meta property="og:image:height" content="772" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#fbfbf9" />
		{GOOGLE_SITE_VERIFICATION && (
			<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
		)}

		{
			structuredData.map((data) => (
				<script type="application/ld+json" set:html={JSON.stringify(data)} />
			))
		}
	</head>
	<body>
		<slot />

		<!-- Umami analytics: cookieless, EU-hosted. Opening any page with ?notrack
		     stops counting this browser (Umami honours localStorage "umami.disabled");
		     ?track turns it back on. Marcin uses this to keep his own visits out. -->
		<script is:inline>
			(function () {
				try {
					var p = new URLSearchParams(location.search);
					var msg = '';
					if (p.has('notrack')) {
						localStorage.setItem('umami.disabled', '1');
						msg = 'Analytics off: this browser is no longer counted.';
					} else if (p.has('track')) {
						localStorage.removeItem('umami.disabled');
						msg = 'Analytics on: this browser is counted again.';
					}
					if (!msg) return;
					p.delete('notrack');
					p.delete('track');
					var q = p.toString();
					history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
					document.addEventListener('DOMContentLoaded', function () {
						var t = document.createElement('div');
						t.textContent = msg;
						t.setAttribute('role', 'status');
						t.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:9999;background:#000;color:#fff;padding:10px 16px;font:600 14px/1.4 system-ui,sans-serif;max-width:calc(100vw - 32px)';
						document.body.appendChild(t);
						setTimeout(function () { t.remove(); }, 5000);
					});
				} catch (e) {}
			})();
		</script>
		<script
			is:inline
			defer
			src="https://cloud.umami.is/script.js"
			data-website-id="2374cc49-fb48-482e-ad1c-c99fd9e44043"
			data-domains="swissdataevents.ch"></script>

		<!-- Cloudflare Web Analytics -->
		<script
			type="module"
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={JSON.stringify({ token: '06cedd898ffb4d4db89b0702657893ed' })}
		></script>
		<!-- End Cloudflare Web Analytics -->
	</body>
</html>
