---
import { SITE_NAME } from '../lib/events';

const LINKEDIN_URL = 'https://www.linkedin.com/in/marcin-czajkowski-data/';
---

<header class="topbar">
	<div class="topbar-inner wrap">
		<a class="brand" href="/">
			<svg class="mark" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
				<rect x="3" y="4" width="18" height="17" fill="none" stroke="currentColor" stroke-width="2"
				></rect>
				<rect x="3" y="4" width="18" height="4.5" class="mark-rule"></rect>
			</svg>
			<span>{SITE_NAME}</span>
		</a>
		<div class="topbar-controls">
			<slot />
			<a
				class="icon-btn"
				href={LINKEDIN_URL}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Connect with Marcin on LinkedIn"
				title="Connect on LinkedIn"
			>
				<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
					<path
						d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
					></path>
				</svg>
			</a>
			<a class="btn ghost" href="/contact/">Contact</a>
		</div>
	</div>
</header>
<div class="masthead-rule" aria-hidden="true"></div>

<style>
	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 22px;
		padding-bottom: 18px;
		flex-wrap: wrap;
		gap: 10px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 11px;
		font-weight: 700;
		font-size: 1.18rem;
		letter-spacing: -0.015em;
		text-decoration: none;
		color: var(--ink);
	}
	/* The mark is the masthead device in miniature: the accent rule over a
	   field. The frame follows the ink so it inverts with the theme. */
	.mark {
		flex: none;
		display: block;
	}
	.mark-rule {
		fill: var(--accent);
	}
	.topbar-controls {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.topbar-controls .btn.ghost {
		height: 32px;
		padding: 0 10px;
	}
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		color: var(--muted);
		text-decoration: none;
	}
	.icon-btn:hover {
		color: var(--accent);
	}
	/* The one bold moment on every page: a single accent rule under the
	   masthead. The only other place the accent appears is the current week. */
	.masthead-rule {
		height: 3px;
		background: var(--accent);
	}
	@media (max-width: 640px) {
		.topbar-inner {
			padding-top: 16px;
			padding-bottom: 14px;
		}
		.brand {
			font-size: 1.05rem;
			gap: 9px;
		}
	}
</style>
